        <script><![CDATA[function previewDocument() {
    var gr = new GlideRecord('sys_attachment');
    gr.addQuery('table_sys_id', g_form.getUniqueValue());
    gr.query(function(att) {
        if (att.next()) {
            var url = '/sys_attachment.do?sys_id=' + att.sys_id;
