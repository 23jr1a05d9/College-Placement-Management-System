        <messages/>
        <name>Student</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {

    if (isLoading || newValue === '') {
        return;
    }

    var value = newValue.trim();

    // E.164 Indian mobile number
    // +91 followed by exactly 10 digits
    // Indian mobile numbers start with 6, 7, 8 or 9
    var pattern = /^\+91[6-9][0-9]{9}$/;

    if (!pattern.test(value)) {

        g_form.showFieldMsg(
            'mobile_number',
            'Enter a valid Indian phone number in E.164 format. Example: +919876543210',
            'error'
        );

        g_form.setValue('mobile_number', '');

    } else {

        g_form.hideFieldMsg('mobile_number');
    }
}]]></script>
