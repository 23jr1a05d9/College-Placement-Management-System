        <xml><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false"
    xmlns:j="jelly:core"
    xmlns:g="glide"
    xmlns:j2="null"
    xmlns:g2="null">

    <tr id="offer_reference_row">

        <td class="label_left" width="100%">
            <label>
                 Offer Letter Reference Template
            </label>
        </td>

        <td>
            <a href="/sys_attachment.do?sys_id=4617a072d1a303107f44be022ea78e75"
               target="_blank">
                View / Download
            </a>
        </td>

    </tr>

    <script>
        function nexoraReferenceVisibility() {

            var checkbox = g_form.getControl('offer_letter_template_required');
            var row = document.getElementById('offer_reference_row');

            if (!checkbox || !row) {
                return;
            }

            if (checkbox.checked) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        }

        addLoadEvent(function() {

            nexoraReferenceVisibility();

            var checkbox = g_form.getControl('offer_letter_template_required');

            if (checkbox) {
                checkbox.addEventListener('change', nexoraReferenceVisibility);
            }

        });
    </script>

</j:jelly>]]></xml>
