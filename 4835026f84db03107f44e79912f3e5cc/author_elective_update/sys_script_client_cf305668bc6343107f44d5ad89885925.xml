        <condition/>
        <description/>
        <field>father_mobile_number</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Limit Father Mobile to 10 Digits</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var fields = ['father_mobile_number', 'mother_mobile_number'];
    var hasError = false;

    for (var i = 0; i < fields.length; i++) {
        var fieldName = fields[i];
        var value = g_form.getValue(fieldName);

        if (value) {
            // Extract raw digits
            var digitsOnly = value.toString().replace(/\D/g, '');

            // Remove India country code (91) if automatically prepended
            if (digitsOnly.length > 10 && digitsOnly.startsWith('91')) {
                digitsOnly = digitsOnly.substring(2);
            }

            // If still more than 10 digits, throw error and auto-trim
            if (digitsOnly.length > 10) {
                g_form.showFieldMsg(fieldName, 'Mobile number cannot exceed 10 digits.', 'error');
                var trimmed = '+91' + digitsOnly.substring(0, 10);
                g_form.setValue(fieldName, trimmed);
                hasError = true;
            } else {
                g_form.hideFieldMsg(fieldName);
            }
        }
    }

    // Stop form submission if any field had an invalid length
    if (hasError) {
        return false;
    }
}]]></script>
