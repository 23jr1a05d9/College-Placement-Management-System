        <messages/>
        <name>Auto Populate Eligibility Count -on load</name>
        <order/>
        <script><![CDATA[function onLoad() {
    var cgpa = g_form.getValue('minimum_cgpa');
    var branches = g_form.getValue('eligible_branches');
    var backlogs = g_form.getValue('max_backlogs');

    // Only query if both key criteria fields have values
    if (!cgpa || !branches) {
        return;
    }

    var ga = new GlideAjax('PlacementDriveUtils');
    ga.addParam('sysparm_name', 'getEligibleStudentCount');
    ga.addParam('sysparm_min_cgpa', cgpa);
    ga.addParam('sysparm_branches', branches);
    ga.addParam('sysparm_max_backlogs', backlogs);

    ga.getXMLAnswer(function(response) {
        var count = parseInt(response, 10);
        g_form.setValue('eligibility_count', isNaN(count) ? 0 : count);
    });
}]]></script>
