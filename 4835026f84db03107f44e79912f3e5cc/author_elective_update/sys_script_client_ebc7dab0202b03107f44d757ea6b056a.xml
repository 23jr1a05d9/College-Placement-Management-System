        <messages/>
        <name>Auto Populate Eligibility Count - CGPA</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading) {
        return;
    }

    var cgpa = g_form.getValue('minimum_cgpa');
    var branches = g_form.getValue('eligible_branches');

    // Reset count to 0 if either required field is empty
    if (!cgpa || !branches) {
        g_form.setValue('eligibility_count', 0);
        return;
    }

    // Call PlacementDriveUtils asynchronously via GlideAjax
    var ga = new GlideAjax('PlacementDriveUtils');
    ga.addParam('sysparm_name', 'getEligibleStudentCount');
    ga.addParam('sysparm_min_cgpa', cgpa);
    ga.addParam('sysparm_branches', branches);

    ga.getXMLAnswer(function(response) {
        g_form.setValue('eligibility_count', parseInt(response, 10) || 0);
    });
}]]></script>
