        <name>Auto Populate Eligible Branches</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || !newValue) {
        if (!newValue) {
            g_form.setValue('eligible_branches', '');
        }
        return;
    }

    // Fetch details from the selected company record
    g_form.getReference('company', function(companyGr) {
        // Replace 'allow_branches' / 'u_allow_branches' with the exact company column name
        var branchValues = companyGr.allow_branches || companyGr.u_allow_branches;

        if (branchValues) {
            // Set values on the List / List Collector field
            g_form.setValue('eligible_branches', branchValues);
        } else {
            g_form.setValue('eligible_branches', '');
        }
    });
}]]></script>
