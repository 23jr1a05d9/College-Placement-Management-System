        <field>mother_mobile_number</field>
        <global>true</global>
        <isolate_script>false</isolate_script>
        <messages/>
        <name>Limit Mother Mobile to 10 Digits</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || !newValue) {
        return;
    }

    // Convert value to string safely
    var valStr = String(newValue);

    // Extract digits
    var digitsOnly = valStr.replace(/\D/g, '');

    // Strip country code 91 if present
    if (digitsOnly.length > 11 && digitsOnly.startsWith('91')) {
        digitsOnly = digitsOnly.substring(2);
    }

    // If longer than 10 digits, format and trim
    if (digitsOnly.length > 11) {
        g_form.showFieldMsg('mother_mobile_number', 'Mobile number cannot exceed 10 digits.', 'error');
        var trimmed = '+91' + digitsOnly.substring(0, 11);
        g_form.setValue('mother_mobile_number', trimmed);
    } else {
        g_form.hideFieldMsg('mother_mobile_number');
    }
}]]></script>
